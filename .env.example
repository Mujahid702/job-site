# BuggedBrain Environment Variables Configuration Template
# Copy this file to .env.local and populate with your own developer credentials

# 1. Supabase Database Configuration
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 2. Redis Caching & Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL="https://[ref].upstash.io"
UPSTASH_REDIS_REST_TOKEN="Ap..."

# 3. AI Providers APIs
GEMINI_API_KEY="AIzaSy..."
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-v1-..."

# 4. NextAuth/Authentication Security Secrets
NEXTAUTH_SECRET="your_nextauth_jwt_signing_secret_hash_here"
NEXTAUTH_URL="http://localhost:3000"

# 5. Third-Party Integrations (Optional / Mocked)
LINKEDIN_CLIENT_ID="86..."
LINKEDIN_CLIENT_SECRET="vw..."
GMAIL_CLIENT_ID="your_google_gmail_client_id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your_gmail_client_secret"
OUTLOOK_CLIENT_ID="your_microsoft_outlook_client_id"
OUTLOOK_CLIENT_SECRET="your_outlook_client_secret"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_API_TOKEN="your_meta_whatsapp_api_token"
