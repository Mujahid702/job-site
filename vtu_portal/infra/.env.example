# ==============================================================================
# VTU SmartPrep AI - Environment Configuration Template
# ==============================================================================

# Database Connection (FastAPI backend uses PostgreSQL asyncpg driver)
# For local dev outside docker: postgresql+asyncpg://admin:devpassword@localhost:5432/vtusmartprep
# For docker-compose: postgresql+asyncpg://admin:devpassword@postgres:5432/vtusmartprep
DATABASE_URL=postgresql+asyncpg://admin:devpassword@postgres:5432/vtusmartprep

# Redis Connection (Used for Caching & Celery Broker)
# For local dev outside docker: redis://localhost:6379/0
# For docker-compose: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Security & Authentication (JWT Access/Refresh tokens config)
SECRET_KEY=dev_secret_key_vtu_smartprep_ai_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage Bucket (AWS S3 or Local dev mock)
STORAGE_BUCKET=vtusmartprep-dev-bucket

# Current Runtime Environment (development | production)
ENVIRONMENT=development
